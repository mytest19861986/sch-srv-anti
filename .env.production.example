# ==========================================
# ServiceYar Production Environment Config
# ==========================================

# Domain & URL Branding
DOMAIN=serviceyar.ir
NEXT_PUBLIC_API_URL=https://serviceyar.ir/api

# Database Configuration (PostgreSQL 16)
DB_HOST=postgres-primary
DB_PORT=5432
DB_NAME=school_transport
DB_USER=school_user
DB_PASSWORD=YourSecureProductionDatabasePassword_2026!

# Redis Cache & Queue
REDIS_URL=redis://redis:6379

# Security & Authentication
JWT_SECRET=SuperSecureRandomJWTSecretKey_32CharactersLong_Prod2026!

# Firebase Cloud Messaging (FCM) for Parent & Driver Push Notifications
# Set full JSON string of service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"serviceyar-prod",...}'

# S3 Compatible Object Storage (AWS S3 / ArvanCloud / MinIO)
S3_BUCKET=serviceyar-prod-media
S3_ACCESS_KEY=YourS3AccessKeyId
S3_SECRET_KEY=YourS3SecretAccessKey
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.ir-tbz-sh1.arvanstorage.ir

# ==========================================
# Multi-Stage Production Dockerfile for Outbox Workers
# Target: Dedicated lightweight image for asynchronous worker scaling
# ==========================================

FROM oven/bun:1.2-alpine AS builder
WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile

COPY src ./src
RUN bun build ./src/modules/attendance/outbox.worker.ts --outdir ./dist-worker --target node

FROM oven/bun:1.2-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV WORKER_CONCURRENCY=10
ENV WORKER_POLL_INTERVAL_MS=1000

RUN addgroup -S workergroup && adduser -S workeruser -G workergroup

COPY package.json bun.lock ./
RUN bun install --production --frozen-lockfile
COPY --from=builder /app/dist-worker ./dist-worker

USER workeruser

ENTRYPOINT ["bun", "run", "dist-worker/outbox.worker.js"]
